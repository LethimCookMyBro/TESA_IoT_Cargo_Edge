server {
    listen ${PORT} default_server;
    server_name _;

    location /mqtt {
        proxy_pass http://127.0.0.1:9001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
    }

    location / {
        root /app/webapp;
        try_files $uri $uri/ =404;
    }
}
