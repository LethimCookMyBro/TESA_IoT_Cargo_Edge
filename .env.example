# Fleet historian credentials. Copy to `.env` and edit, or export these in your shell.
# Every variable here is read by cargo/db.py::settings_from_env and by docker-compose.yml.
# Nothing in this file reaches the browser: the dashboard reads history through the read-only API.
CARGOSHIELD_PG_HOST=127.0.0.1
CARGOSHIELD_PG_PORT=5433
CARGOSHIELD_PG_DATABASE=cargoshield
CARGOSHIELD_PG_USER=cargoshield
CARGOSHIELD_PG_PASSWORD=cargoshield-local-dev

# SELECT-only role used by the maintenance copilot boundary (cargo/maintenance.py).
# Created/refreshed by `python -m cargo.db`. It cannot INSERT, UPDATE or DELETE anything.
CARGOSHIELD_PG_READONLY_USER=cargoshield_readonly
CARGOSHIELD_PG_READONLY_PASSWORD=cargoshield-readonly-local
